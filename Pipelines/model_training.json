{
  "Version": "2020-12-01",
  "Parameters": [
    {
      "Name": "PreprocessImageUri",
      "Type": "String",
      "DefaultValue": "474532148129.dkr.ecr.eu-west-1.amazonaws.com/delta/kulsum_airline_customer_segmentation:preprocess-latest"
    },
    {
      "Name": "FeatureImageUri",
      "Type": "String",
      "DefaultValue": "474532148129.dkr.ecr.eu-west-1.amazonaws.com/delta/kulsum_airline_customer_segmentation:feature-latest"
    },
    {
      "Name": "TrainImageUri",
      "Type": "String",
      "DefaultValue": "474532148129.dkr.ecr.eu-west-1.amazonaws.com/delta/kulsum_airline_customer_segmentation:train-latest"
    },
    {
      "Name": "TrainingExecutionRole",
      "Type": "String",
      "DefaultValue": "arn:aws:iam::474532148129:role/sm-provisioning/datazone_usr_sagemaker_execution_role_62mkhxohpoeuja"
    },
    {
      "Name": "NumRounds",
      "Type": "String",
      "DefaultValue": "100"
    },
    {
      "Name": "InputFileName",
      "Type": "String",
      "Description": "Name of the input file (e.g., flight.csv)",
      "DefaultValue": "flight.csv"
    },
    {
      "Name": "PreprocessOutputUri",
      "Type": "String",
      "Description": "Full S3 URI for Preprocess output (e.g., s3://bucket/output/preprocess)",
      "DefaultValue": "s3://airline-customer-segmentation/output/preprocess"
    },
    {
      "Name": "FeatureInputUri",
      "Type": "String",
      "Description": "Full S3 URI for Feature Engineering input (e.g., s3://bucket/output/preprocess/processed_data.csv)",
      "DefaultValue": "s3://airline-customer-segmentation/output/preprocess/processed_data.csv"
    },
    {
      "Name": "FeatureOutputUri",
      "Type": "String",
      "Description": "Full S3 URI for Feature Engineering output (e.g., s3://bucket/output/feature)",
      "DefaultValue": "s3://airline-customer-segmentation/output/feature"
    },
    {
      "Name": "TrainTrainUri",
      "Type": "String",
      "Description": "Full S3 URI for training input (train channel, e.g., s3://bucket/output/feature/train/train.csv)",
      "DefaultValue": "s3://airline-customer-segmentation/output/feature/train/train.csv"
    },
    {
      "Name": "TrainTestUri",
      "Type": "String",
      "Description": "Full S3 URI for training input (test channel, e.g., s3://bucket/output/feature/test/test.csv)",
      "DefaultValue": "s3://airline-customer-segmentation/output/feature/test/test.csv"
    },
    {
      "Name": "TrainOutputUri",
      "Type": "String",
      "Description": "Full S3 URI for training output (e.g., s3://bucket/output/train)",
      "DefaultValue": "s3://airline-customer-segmentation/output/train"
    }
  ],
  "Steps": [
    {
      "Name": "PreprocessData",
      "Type": "Processing",
      "Arguments": {
        "RoleArn": { "Get": "Parameters.TrainingExecutionRole" },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.large",
            "VolumeSizeInGB": 30
          }
        },
        "AppSpecification": {
          "ImageUri": { "Get": "Parameters.PreprocessImageUri" },
          "ContainerArguments": [
            "--input-file-name", { "Get": "Parameters.InputFileName" },
            "--drop-na", "True"
          ]
        },
        "ProcessingInputs": [
          {
            "InputName": "input",
            "S3Input": {
              "S3Uri": "s3://airline-customer-segmentation/data/input_data/flight.csv",
              "LocalPath": "/opt/ml/processing/input",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "output",
              "S3Output": {
                "S3Uri": { "Get": "Parameters.PreprocessOutputUri" },
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        }
      }
    },
    {
      "Name": "FeatureEngineering",
      "Type": "Processing",
      "DependsOn": [
        "PreprocessData"
      ],
      "Arguments": {
        "RoleArn": { "Get": "Parameters.TrainingExecutionRole" },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.large",
            "VolumeSizeInGB": 30
          }
        },
        "AppSpecification": {
          "ImageUri": { "Get": "Parameters.FeatureImageUri" },
          "ContainerArguments": [
            "--test-size", "0.2",
            "--random-state", "42"
          ]
        },
        "ProcessingInputs": [
          {
            "InputName": "input",
            "S3Input": {
              "S3Uri": { "Get": "Parameters.FeatureInputUri" },
              "LocalPath": "/opt/ml/processing/input",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "output",
              "S3Output": {
                "S3Uri": { "Get": "Parameters.FeatureOutputUri" },
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        }
      }
    },
    {
      "Name": "TrainXgboostModel",
      "Type": "Training",
      "DependsOn": [
        "FeatureEngineering"
      ],
      "Arguments": {
        "RoleArn": { "Get": "Parameters.TrainingExecutionRole" },
        "AlgorithmSpecification": {
          "TrainingImage": { "Get": "Parameters.TrainImageUri" },
          "TrainingInputMode": "File"
        },
        "InputDataConfig": [
          {
            "ChannelName": "train",
            "DataSource": {
              "S3DataSource": {
                "S3Uri": { "Get": "Parameters.TrainTrainUri" },
                "S3DataType": "S3Prefix"
              }
            },
            "ContentType": "text/csv"
          },
          {
            "ChannelName": "test",
            "DataSource": {
              "S3DataSource": {
                "S3Uri": { "Get": "Parameters.TrainTestUri" },
                "S3DataType": "S3Prefix"
              }
            },
            "ContentType": "text/csv"
          }
        ],
        "OutputDataConfig": {
          "S3OutputPath": { "Get": "Parameters.TrainOutputUri" }
        },
        "ResourceConfig": {
          "InstanceCount": 1,
          "InstanceType": "ml.m5.large",
          "VolumeSizeInGB": 30
        },
        "HyperParameters": {
          "num_rounds": { "Get": "Parameters.NumRounds" }
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 3600
        }
      }
    }
  ]
}
